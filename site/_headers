/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org https://demotiles.maplibre.org https://cwommbzfvfeavjbovkkq.supabase.co wss://cwommbzfvfeavjbovkkq.supabase.co; font-src 'self' https://demotiles.maplibre.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://buy.stripe.com https://billing.stripe.com; object-src 'none'

# One Content-Security-Policy, in one place. A second, stricter policy on /app.html did not replace
# this one: Cloudflare sent both, browsers enforce both, and the stricter directive won, which
# blocked the very connection the second rule existed to allow. Supabase is therefore listed here in
# connect-src. script-src stays at 'self' because the client library is vendored under /vendor
# rather than loaded from a CDN, so no third-party script runs on any page.

/app.html
  Cache-Control: no-store
  X-Robots-Tag: noindex

/api/v1/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/api/v1/search/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
/api/
  Cache-Control: no-cache
/api/index.html
  Cache-Control: no-cache
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/vendor/*
  Cache-Control: public, max-age=604800
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/api/v1/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
